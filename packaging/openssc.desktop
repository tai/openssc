[Desktop Entry]
Type=Application
Version=1.0
Name=OpenSSC
GenericName=Apple Screen Sharing client
Comment=Apple Screen Sharing client with a saved-target connection manager
# The launcher opens the connection manager on Linux; MVS and evdev are the
# child defaults, so a manager Connect gets the fast path with no extra flags.
Exec=openssc-launch
TryExec=openssc-launch
Icon=openssc
Terminal=false
Categories=Network;RemoteAccess;
Keywords=screen sharing;vnc;rfb;apple;remote desktop;
StartupNotify=true
StartupWMClass=openssc
